<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verification</title>
    <style>
        /* Basic email-friendly styling (no external assets) */
        body {
            margin: 0;
            padding: 0;
            background: #f6f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #1f2937;
        }
        .container {
            width: 100%;
            padding: 24px 12px;
        }
        .card {
            max-width: 560px;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
        }
        .header {
            padding: 18px 20px;
            background: #111827;
            color: #ffffff;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 0.2px;
        }
        .content {
            padding: 22px 20px 10px;
        }
        h1 {
            margin: 0 0 10px;
            font-size: 20px;
            line-height: 1.3;
        }
        p {
            margin: 0 0 12px;
            font-size: 14px;
            line-height: 1.6;
            color: #374151;
        }
        .buttonWrap {
            padding: 10px 20px 22px;
        }
        .button {
            display: inline-block;
            background: #2563eb;
            color: #ffffff !important;
            text-decoration: none;
            padding: 12px 16px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 14px;
        }
        .footer {
            padding: 16px 20px 22px;
            border-top: 1px solid #e5e7eb;
            background: #fafafa;
        }
        .muted {
            color: #6b7280;
            font-size: 12px;
            line-height: 1.5;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="header">NotesApp</div>

            <div class="content">
                <h1>Verify your email</h1>
                <p>Thanks for signing up. Please confirm your email address to activate your account.</p>
                <p>This link may expire soon. If you didn’t create an account, you can ignore this email.</p>
            </div>

            <div class="buttonWrap">
                <a class="button" href="{{verifyUrl}}" target="_blank" rel="noopener">Verify Email</a>
            </div>

            <div class="footer">
                <p class="muted">If the button doesn’t work, copy and paste this link into your browser:</p>
                <p class="muted">{{verifyUrl}}</p>
            </div>
        </div>
    </div>
</body>
</html>